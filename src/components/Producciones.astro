<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Lacquer&display=swap" as="style" onload="this.rel='stylesheet'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lacquer&display=swap">
    </noscript>

    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .txt {
            position: relative;
            right: 11rem;
        }

        h2 {
            color: white;
        }

        .h2-2 {
            color: #CA1DA4;
        }

        .slider-container {
            position: relative;
            width: 80%;
            max-width: 1200px;
            overflow: hidden;
            background-color: transparent;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .slider {
            display: flex;
            transition: transform 0.5s ease-in-out;
        }

        .slide {
            min-width: 33.3333%;
            box-sizing: border-box;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .slide .image-container {
            width: 100%;
            height: 20rem;
        }

        .slide .image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        audio {
            width: 100%;
            background-color: #f1f3f4;
            outline: none;
        }

        .prev, .next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background-color: transparent;
            color: white;
            border: none;
            cursor: pointer;
            z-index: 1;
            font-size: 3rem;
        }

        .prev {
            left: -8px;
        }

        .next {
            right: -8px;
        }

        .prev:hover, .next:hover {
            background-color: rgba(0, 0, 0, 0.7);
        }

        .audio-player::-webkit-media-controls-enclosure {
            overflow: hidden;
        }

        .audio-player::-webkit-media-controls-panel {
            width: calc(100% - 35px);
        }

        .audio-player::-webkit-media-controls-download-button {
            display: none;
        }

        @media screen and (max-width: 550px) {
            .slider-container {
                width: 90%;
            }

            .slide {
                min-width: 95%;
            }

            .txt {
                position: static;
            }
        }

    </style>
</head>
<body>
    <div id="produccion" class="txt">
        <h2>MIS</h2>
        <h2 class="h2-2">PRODUCCIONES</h2>
    </div>

    <div class="slider-container">
        <button class="prev">&#10094;</button>
        <div class="slider">
            <div class="slide">
                <div class="image-container">
                    <img loading="lazy" src="callejon.jpg" alt="Image 1">
                </div>
                <audio controls class="audio-player">
                    <source src="/Beat1cumbia.mp3" type="audio/mp3">
                    Tu navegador no soporta el elemento de audio.
                </audio>
            </div>
            <div class="slide">
                <div class="image-container">
                    <img loading="lazy" src="/tropi.webp" alt="Image 2">
                </div>
                <audio controls class="audio-player">
                    <source src="Beat2.mp3" type="audio/mp3">
                    Tu navegador no soporta el elemento de audio.
                </audio>
            </div>
            <div class="slide">
                <div class="image-container">
                    <img loading="lazy" src="/night-sea.jpg" alt="Image 3">
                </div>
                <audio controls class="audio-player">
                    <source src="Beat3.mp3" type="audio/mp3">
                    Tu navegador no soporta el elemento de audio.
                </audio>
            </div>
            <div class="slide">
                <div class="image-container">
                    <img loading="lazy" src="/neon.jpg" alt="Image 4">
                </div>
                <audio controls class="audio-player">
                    <source src="Beat4.mp3" type="audio/mp3">
                    Tu navegador no soporta el elemento de audio.
                </audio>
            </div>
        </div>
        <button class="next">&#10095;</button>
    </div>

<script>
    // Obtener los botones y el slider
    const prevButton = document.querySelector('.prev');
    const nextButton = document.querySelector('.next');
    const slider = document.querySelector('.slider');
    let currentSlide = 0; // Asegurarse de que la variable esté declarada

    if (slider && prevButton && nextButton) {
        // Función para mostrar la diapositiva correspondiente
        function showSlide(index) {
            const slides = document.querySelectorAll('.slide');
            const totalSlides = slides.length;

            // Ajustar el índice para el ciclo de diapositivas
            currentSlide = (index + totalSlides) % totalSlides;

            // Mostrar las diapositivas de forma horizontal
            const offset = -currentSlide * 100 / totalSlides;
            slider.style.transform = `translateX(${offset}%)`;
        }

        // Eventos de clic para cambiar de diapositiva
        prevButton.addEventListener('click', () => showSlide(currentSlide - 1));
        nextButton.addEventListener('click', () => showSlide(currentSlide + 1));

        // Mostrar la primera diapositiva al cargar la página
        showSlide(currentSlide);
    } else {
        console.error("Error: no se encontraron los elementos del slider.");
    }
</script>
</body>
</html>
